# demo = local seed + localStorage (no vision-api, no axios in data path)
# api  = JWT + vision-api
# Vite resolves `@backend` → src/backends/{demo|api}
#
# Prefer npm run dev / npm run dev:api (they load .env.demo / .env.api).
# Copy this file to .env.local only if you need an override.
VITE_APP_MODE=demo

# Required when VITE_APP_MODE=api
VITE_API_URL=http://localhost:4000/api/v1
